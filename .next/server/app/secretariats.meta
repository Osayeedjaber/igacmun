{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/secretariats/layout,_N_T_/secretariats/page,_N_T_/secretariats"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/secretariats/__PAGE__",
    "/secretariats",
    "/_index",
    "/_head"
  ]
}